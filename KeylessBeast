local hitboxEnabled = false
local headChamsEnabled = false
local hitboxSize = 2
local headChamsColor = Color3.fromRGB(255, 255, 0)
local originalHeadSizes = {}
local originalLocalHeadSize = nil
local headChamsDrawings = {}
local hitboxRefreshConn = nil

local DEFAULT_HEAD_SIZE = Vector3.new(1.2, 1.2, 1.2)

local function isNormalHeadSize(size)
    return size.X <= 2.5 and size.Y <= 2.5 and size.Z <= 2.5
end

local function forceProtectLocalHead()
    local char = LocalPlayer.Character
    if not char then return end

    local head = char:FindFirstChild("Head")
    if not (head and head:IsA("BasePart")) then return end

    -- Jeśli nie mamy zapisanego rozmiaru albo zapisany jest nienormalny → spróbuj złapać dobry
    if not originalLocalHeadSize or not isNormalHeadSize(originalLocalHeadSize) then
        if isNormalHeadSize(head.Size) then
            originalLocalHeadSize = head.Size
        else
            originalLocalHeadSize = DEFAULT_HEAD_SIZE
        end
    end

    -- Zawsze wymuszamy normalny rozmiar
    if (head.Size - originalLocalHeadSize).Magnitude > 0.05 then
        head.Size = originalLocalHeadSize
    end
    head.CanCollide = true
end

-- Ochrona działa ZAWSZE
RunService.Heartbeat:Connect(function()
    forceProtectLocalHead()
end)

local function updateHitbox(plr)
    if plr == LocalPlayer then return end

    local char = plr.Character
    local head = char and char:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        if hitboxEnabled then
            if not originalHeadSizes[plr] then
                originalHeadSizes[plr] = head.Size
            end
            head.Size = originalHeadSizes[plr] * hitboxSize
            head.CanCollide = false
        else
            if originalHeadSizes[plr] then
                head.Size = originalHeadSizes[plr]
                head.CanCollide = true
            end
        end
    end
end

local function updateHeadChams(plr)
    if plr == LocalPlayer then return end

    local char = plr.Character
    local head = char and char:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        local highlight = headChamsDrawings[plr]
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.FillColor = headChamsColor
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Parent = head
            headChamsDrawings[plr] = highlight
        end
        highlight.Adornee = headChamsEnabled and head or nil
        highlight.FillColor = headChamsColor
        highlight.Enabled = headChamsEnabled and head ~= nil
    end
end

local function refreshHitboxes()
    if hitboxRefreshConn then
        hitboxRefreshConn:Disconnect()
        hitboxRefreshConn = nil
    end

    hitboxRefreshConn = RunService.Heartbeat:Connect(function()
        if hitboxEnabled then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    updateHitbox(plr)
                end
            end
        end
    end)
end

-- Obsługa respawnu – najważniejsza część naprawy
LocalPlayer.CharacterAdded:Connect(function(char)
    originalLocalHeadSize = nil

    task.spawn(function()
        local head = char:WaitForChild("Head", 6)
        if not head then return end

        -- Czekamy aż postać się w pełni załaduje
        task.wait(1.2)

        if head and head.Parent then
            if isNormalHeadSize(head.Size) then
                originalLocalHeadSize = head.Size
            else
                originalLocalHeadSize = DEFAULT_HEAD_SIZE
                head.Size = DEFAULT_HEAD_SIZE
            end
            forceProtectLocalHead()
        end
    end)
end)

